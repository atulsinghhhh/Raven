generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}


datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}


enum ProjectRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
  BILLING
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum RoomStatus {
  ACTIVE
  CLOSED
}

enum ParticipantStatus {
  PENDING
  JOINED
  LEFT
}

enum ConnectionState {
  CONNECTING
  CONNECTED
  RECONNECTING
  DISCONNECTED
  FAILED
}

enum ErrorCategory {
  AUTHENTICATION_ERROR
  AUTHORIZATION_ERROR
  TOKEN_ERROR
  SIGNALING_ERROR
  ICE_ERROR
  TURN_ERROR
  SFU_ERROR
  NETWORK_ERROR
  CLIENT_ERROR
  UNKNOWN_ERROR
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  name            String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projects         Project[]
  memberships      ProjectMember[]
  tokens           UserToken[]
  authAccounts     AuthAccount[]
  onboarding       UserOnboarding?
  usageAllowances  UsageAllowance[]
  liveStreamsOwned LiveStream[]

  @@map("users")
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model UserToken {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       UserTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

enum AuthProvider {
  GITHUB
  GOOGLE
}


model AuthAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          AuthProvider
  providerAccountId String
  email             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model UserOnboarding {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step        Int       @default(1)
  completedAt DateTime?

  useCases        String[] @default([])
  experienceLevel String?
  stack           String[] @default([])

  createdFirstProject Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_onboarding")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  allowedOrigins        String[] @default([])
  allowLocalhostOrigins Boolean  @default(true)

  members     ProjectMember[]
  auditLogs   AuditLog[]
  apiKeys     ApiKey[]
  rooms       Room[]
  connections Connection[]
  errorEvents ErrorEvent[]

  conversations    Conversation[]
  chatConnections  ChatConnection[]
  webhookEndpoints WebhookEndpoint[]
  liveStreams      LiveStream[]
  usageSessions    UsageSession[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ProjectRole @default(DEVELOPER)
  invitedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model AuditLog {
  id           String       @id @default(uuid())
  publicId     String       @unique
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment  Environment?
  actorId      String?
  actorEmail   String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  requestId    String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, action])
  @@index([actorId])
  @@map("audit_logs")
}

model ApiKey {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment  @default(DEVELOPMENT)
  publicId    String       @unique
  secretHash  String
  name        String?
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  @@index([projectId])
  @@map("api_keys")
}

model Room {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @default(DEVELOPMENT)
  name        String
  status      RoomStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  rtcServerId String?
  rtcServer   RtcServer? @relation(fields: [rtcServerId], references: [id], onDelete: SetNull)

  participants Participant[]
  rtcTokens    RtcToken[]
  conversation Conversation?
  liveStream   LiveStream?

  @@unique([projectId, environment, name])
  @@index([projectId])
  @@index([rtcServerId])
  @@map("rooms")
}

model Participant {
  id        String            @id @default(uuid())
  roomId    String
  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  identity  String
  status    ParticipantStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  rtcTokens RtcToken[]

  @@unique([roomId, identity])
  @@map("participants")
}

model RtcToken {
  id            String      @id @default(uuid())
  projectId     String
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  permissions   Json
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([projectId])
  @@index([roomId])
  @@map("rtc_tokens")
}

model Connection {
  id                  String          @id @default(uuid())
  publicId            String          @unique
  projectId           String
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment         Environment     @default(DEVELOPMENT)
  roomId              String?
  roomName            String
  participantId       String?
  participantIdentity String
  state               ConnectionState @default(CONNECTING)
  disconnectReason    String?
  region              String?
  sdkVersion          String?
  platform            String?
  browser             String?
  networkType         String?
  iceConnectionState  String?
  signalingState      String?
  connectionQuality   String?
  rttMs               Int?
  jitterMs            Int?
  packetLossPercent   Float?
  bitrateBps          Int?
  codec               String?
  reconnectCount      Int             @default(0)
  startedAt           DateTime        @default(now())
  connectedAt         DateTime?
  disconnectedAt      DateTime?
  durationMs          Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  events ConnectionEvent[]
  errors ErrorEvent[]

  @@index([projectId])
  @@index([roomId])
  @@index([participantId])
  @@index([createdAt])
  @@map("connections")
}

model ConnectionEvent {
  id           String     @id @default(uuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type         String
  data         Json?
  timestamp    DateTime   @default(now())

  @@index([connectionId])
  @@index([timestamp])
  @@map("connection_events")
}


model ErrorEvent {
  id              String        @id @default(uuid())
  publicId        String        @unique
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment     Environment   @default(DEVELOPMENT)
  connectionId    String?
  connection      Connection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  roomId          String?
  participantId   String?
  category        ErrorCategory
  message         String
  likelyCause     String?
  suggestedAction String?
  sdkVersion      String?
  platform        String?
  timestamp       DateTime      @default(now())

  @@index([projectId])
  @@index([connectionId])
  @@index([category])
  @@index([timestamp])
  @@map("error_events")
}


enum ConversationType {
  ROOM
  CHANNEL
  DIRECT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum ChatMemberStatus {
  ACTIVE
  LEFT
}

enum MessageType {
  TEXT
  SYSTEM
  EVENT
  ATTACHMENT
}

enum AttachmentStatus {
  PENDING
  UPLOADED
  EXPIRED
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}


model Conversation {
  id            String             @id @default(uuid())
  publicId      String             @unique
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment        @default(DEVELOPMENT)
  roomId        String?            @unique
  room          Room?              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name          String
  type          ConversationType   @default(CHANNEL)
  status        ConversationStatus @default(ACTIVE)
  retentionDays Int?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  members     ChatMember[]
  messages    Message[]
  reactions   Reaction[]
  readStates  ReadState[]
  attachments Attachment[]
  connections ChatConnection[]
  liveStream  LiveStream?

  @@unique([projectId, environment, name])
  @@index([projectId, createdAt])
  @@map("chat_conversations")
}


model ChatMember {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String
  userId         String
  role           ChatMemberRole   @default(MEMBER)
  status         ChatMemberStatus @default(ACTIVE)
  metadata       Json?
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([projectId, userId])
  @@map("chat_members")
}

model Message {
  id               String       @id @default(uuid())
  publicId         String       @unique
  projectId        String
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  roomId           String?
  senderId         String
  type             MessageType  @default(TEXT)
  content          String?
  replyToMessageId String?
  replyToMessage   Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")
  threadRootId     String?
  clientMessageId  String?
  metadata         Json?
  editedAt         DateTime?
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  reactions   Reaction[]
  readStates  ReadState[]
  attachments Attachment[]

  @@unique([conversationId, senderId, clientMessageId], map: "chat_messages_idempotency_key")
  @@index([conversationId, createdAt, publicId])
  @@index([senderId, createdAt])
  @@index([threadRootId, createdAt])
  @@map("chat_messages")
}

model Reaction {
  id             String       @id @default(uuid())
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

model ReadState {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId         String
  userId            String
  lastReadMessageId String?
  lastReadMessage   Message?     @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)
  lastReadAt        DateTime
  updatedAt         DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([lastReadMessageId])
  @@map("chat_read_states")
}


model Attachment {
  id             String           @id @default(uuid())
  publicId       String           @unique
  projectId      String
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId     String
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String           @unique
  status         AttachmentStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now())
  uploadedAt     DateTime?

  @@index([conversationId])
  @@index([messageId])
  @@map("chat_attachments")
}


model ChatConnection {
  id               String          @id @default(uuid())
  publicId         String          @unique
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment      Environment     @default(DEVELOPMENT)
  conversationId   String?
  conversation     Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  userId           String
  gatewayId        String
  state            ConnectionState @default(CONNECTING)
  disconnectReason String?
  sdkVersion       String?
  platform         String?
  messagesSent     Int             @default(0)
  connectedAt      DateTime?
  disconnectedAt   DateTime?
  durationMs       Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("chat_connections")
}


model WebhookEndpoint {
  id                  String                @id @default(uuid())
  publicId            String                @unique
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment         Environment           @default(DEVELOPMENT)
  url                 String
  description         String?
  enabledEvents       String[]              @default([])
  signingSecret       String
  status              WebhookEndpointStatus @default(ACTIVE)
  consecutiveFailures Int                   @default(0)
  lastDeliveryAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id          String      @id @default(uuid())
  publicId    String      @unique
  projectId   String
  environment Environment @default(DEVELOPMENT)
  type        String
  payload     Json
  createdAt   DateTime    @default(now())

  deliveries WebhookDelivery[]

  @@index([projectId, createdAt])
  @@map("webhook_events")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  eventId        String
  event          WebhookEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}


enum LiveStreamStatus {
  CREATED
  STARTING
  LIVE
  ENDING
  ENDED
}

enum LiveStreamVisibility {
  PUBLIC
  PRIVATE
  AUTHENTICATED
}

enum LiveStreamHostRole {
  HOST
  CO_HOST
}

enum LiveStreamDeliveryMode {
  RTC_ONLY
  BROADCAST
}

enum LiveStreamEgressStatus {
  NOT_STARTED
  STARTING
  RUNNING
  STOPPING
  STOPPED
  FAILED
}

model LiveStream {
  id          String      @id @default(uuid())
  publicId    String      @unique
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @default(DEVELOPMENT)
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  roomId String @unique
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  conversationId    String?       @unique
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  chatRootMessageId String?

  title        String
  description  String?
  thumbnailUrl String?
  category     String?
  tags         String[]             @default([])
  language     String?
  visibility   LiveStreamVisibility @default(PUBLIC)
  metadata     Json?

  status          LiveStreamStatus @default(CREATED)
  peakViewerCount Int              @default(0)

  // Broadcast redesign: RTC_ONLY (default) is today's viewer-as-RTC-participant
  // behavior, unchanged for every existing/not-yet-opted-in stream. BROADCAST
  // means the audience never gets an RTC viewer token — see LiveStreamEgress.
  deliveryMode LiveStreamDeliveryMode @default(RTC_ONLY)

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hosts  LiveStreamHost[]
  egress LiveStreamEgress?

  @@unique([projectId, environment, roomId])
  @@index([projectId, environment, status])
  @@index([projectId, environment, createdAt])
  @@map("live_streams")
}

model LiveStreamHost {
  id       String     @id @default(uuid())
  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  identity String
  role     LiveStreamHostRole @default(CO_HOST)

  invitedAt DateTime  @default(now())
  removedAt DateTime?

  @@unique([streamId, identity])
  @@index([streamId])
  @@map("live_stream_hosts")
}

// One egress-worker run per BROADCAST-mode stream: tracks the HLS pipeline's
// own lifecycle (distinct from LiveStream.status, which only ever reflects
// the host's RTC session). Deliberately a child table rather than JSON on
// LiveStream — playbackUrl/lastSegmentAt/status are independently and
// frequently updated by worker heartbeats, unlike LiveStream.metadata, which
// stays purely developer-owned.
model LiveStreamEgress {
  id       String     @id @default(uuid())
  streamId String     @unique
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  status LiveStreamEgressStatus @default(NOT_STARTED)

  workerId      String?
  playbackUrl   String?
  hlsReadyAt    DateTime?
  lastSegmentAt DateTime?
  lastError     String?

  startedAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@map("live_stream_egress")
}


enum RtcServerStatus {
  HEALTHY
  DRAINING
  UNHEALTHY
}

model RtcServer {
  id     String          @id @default(uuid())
  name   String          @unique
  region String
  status RtcServerStatus @default(HEALTHY)
  publicHost  String
  internalUrl String

  capacity Int @default(100)

  activeRooms        Int @default(0)
  activeParticipants Int @default(0)

  cpuPercent    Float?
  memoryPercent Float?
  networkInBps  Float?
  networkOutBps Float?

  version String?

  lastHeartbeatAt DateTime?
  registeredAt    DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rooms Room[]

  @@index([region, status])
  @@map("rtc_servers")
}


enum UsageAllowanceSource {
  FREE_TIER
}

enum UsageProduct {
  RTC
  CHAT
  LIVE_STREAMING
}

enum UsageKind {
  RTC_PARTICIPANT_MINUTES
  LIVE_STREAMING_HOST_MINUTES
}

model UsageAllowance {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product UsageProduct @default(RTC)

  source UsageAllowanceSource @default(FREE_TIER)

  includedMinutes Int?

  consumedSeconds Int @default(0)

  includedCount Int?

  consumedCount Int @default(0)


  exhaustedAt DateTime?

  grantedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions UsageSession[]

  @@unique([userId, product])
  @@map("usage_allowances")
}


model UsageSession {
  id String @id @default(uuid())

  sessionKey String @unique

  allowanceId String
  allowance   UsageAllowance @relation(fields: [allowanceId], references: [id], onDelete: Cascade)

  userId String

  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @default(DEVELOPMENT)

  roomId              String?
  roomName            String
  participantIdentity String

  product UsageProduct @default(RTC)

  kind UsageKind @default(RTC_PARTICIPANT_MINUTES)

  startedAt DateTime @default(now())

  meteredSeconds Int @default(0)
  lastMeteredAt DateTime @default(now())

  endedAt     DateTime?
  closeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([userId, startedAt])
  @@index([projectId, startedAt])
  @@index([endedAt, lastMeteredAt])
  @@map("usage_sessions")
}
