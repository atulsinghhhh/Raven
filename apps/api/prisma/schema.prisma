// Raven control plane schema.
// See docs/architecture/infrastructure-decisions.md for why Prisma/Postgres.
// See docs/control-plane.md for the full data-model rationale.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 dropped `url` here — it lives in prisma.config.ts for the CLI now,
// and PrismaClient gets it via the driver adapter (prisma.service.ts).
// https://pris.ly/d/config-datasource
datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Three fixed environments per project. Not a table: they are not
/// user-created, there are always exactly these three, and a row per
/// project per environment would buy nothing until there is
/// per-environment configuration to store in it.
enum Environment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

/// Who may do what within a project. Deliberately a small fixed set:
/// a general permission system would be more flexible and much harder to
/// reason about, and "who can rotate the production key" needs to be
/// answerable at a glance. The capability each role carries lives in
/// project-permissions.ts, not here, so the mapping can change without a
/// migration.
enum ProjectRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
  BILLING
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum RoomStatus {
  ACTIVE
  CLOSED
}

enum ParticipantStatus {
  PENDING
  JOINED
  LEFT
}

enum ConnectionState {
  CONNECTING
  CONNECTED
  RECONNECTING
  DISCONNECTED
  FAILED
}

/// Raven-facing error categories (Phase 9 spec §18) — never the raw
/// LiveKit/coturn error a developer would have to reverse-engineer.
enum ErrorCategory {
  AUTHENTICATION_ERROR
  AUTHORIZATION_ERROR
  TOKEN_ERROR
  SIGNALING_ERROR
  ICE_ERROR
  TURN_ERROR
  SFU_ERROR
  NETWORK_ERROR
  CLIENT_ERROR
  UNKNOWN_ERROR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects    Project[]
  memberships ProjectMember[]

  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     ProjectMember[]
  apiKeys     ApiKey[]
  rooms       Room[]
  connections Connection[]
  errorEvents ErrorEvent[]

  conversations    Conversation[]
  chatConnections  ChatConnection[]
  webhookEndpoints WebhookEndpoint[]

  @@index([ownerId])
  @@map("projects")
}

/// The raw secret is never stored — only a hash of it. `publicId` is the
/// fast, non-secret lookup key used to find the row before verifying the
/// secret against `secretHash`. See docs/control-plane.md#api-keys.
/// A user's membership of a project. `Project.ownerId` still records who
/// created it, but authorization reads this table — an owner is simply a
/// member holding the OWNER role, and every project has at least one.
model ProjectMember {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ProjectRole @default(DEVELOPER)
  /// Who added them. Null for the backfilled memberships of projects that
  /// predate this table, where there is no honest answer.
  invitedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model ApiKey {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Which environment this key grants access to. The single source of
  /// truth for an API-key-authenticated request — a caller never gets to
  /// name the environment it is operating in.
  environment Environment  @default(DEVELOPMENT)
  publicId    String       @unique
  secretHash  String
  name        String?
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  @@index([projectId])
  @@map("api_keys")
}

model Room {
  id          String      @id @default(uuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment Environment @default(DEVELOPMENT)
  name        String
  status      RoomStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  participants Participant[]
  rtcTokens    RtcToken[]
  /// The chat channel attached to this RTC room, if one was created.
  /// Chat and RTC stay separate services — this is the only join between them.
  conversation Conversation?

  // Room names are unique within one environment of one project. Staging
  // and production must both be able to hold a "lobby" — that is most of
  // what environment isolation means in practice.
  @@unique([projectId, environment, name])
  @@index([projectId])
  @@map("rooms")
}

/// A logical identity within a room's control-plane record. Real join/leave
/// state (from LiveKit webhooks) is wired up in a later phase; for now this
/// row exists so RTC tokens have something durable to reference and so a
/// consistent identity is enforced per room.
model Participant {
  id        String            @id @default(uuid())
  roomId    String
  room      Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  identity  String
  status    ParticipantStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  rtcTokens RtcToken[]

  @@unique([roomId, identity])
  @@map("participants")
}

/// A control-plane record of a granted RTC token. The actual bearer
/// credential is a signed LiveKit JWT returned once at creation time and
/// never persisted — this row is the audit/metadata trail, not the secret
/// itself. See docs/control-plane.md#rtc-tokens.
model RtcToken {
  id            String      @id @default(uuid())
  projectId     String
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  permissions   Json
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([projectId])
  @@index([roomId])
  @@map("rtc_tokens")
}

/// A real RTC connection, event-sourced from best-effort SDK telemetry
/// (Phase 9) — distinct from `RtcToken` (a grant) and from LiveKit's own
/// internal session bookkeeping. `publicId` (`conn_...`) is generated
/// client-side by `@raven/rtc` at `join()` time and is the ID surfaced in
/// the dashboard, the CLI, and any error report, so a developer can
/// correlate all three without ever touching LiveKit/coturn directly. See
/// docs/observability.md#connection-lifecycle.
model Connection {
  id                  String          @id @default(uuid())
  publicId            String          @unique
  projectId           String
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment         Environment     @default(DEVELOPMENT)
  roomId              String?
  roomName            String
  participantId       String?
  participantIdentity String
  state               ConnectionState @default(CONNECTING)
  disconnectReason    String?
  region              String?
  sdkVersion          String?
  platform            String?
  browser             String?
  networkType         String?
  iceConnectionState  String?
  signalingState      String?
  reconnectCount      Int             @default(0)
  startedAt           DateTime        @default(now())
  connectedAt         DateTime?
  disconnectedAt      DateTime?
  durationMs          Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  events ConnectionEvent[]
  errors ErrorEvent[]

  @@index([projectId])
  @@index([roomId])
  @@index([participantId])
  @@index([createdAt])
  @@map("connections")
}

/// The append-only timeline behind a Connection's detail view (Phase 9
/// spec §17) — every lifecycle transition and metadata update, never
/// mutated after being written.
model ConnectionEvent {
  id           String     @id @default(uuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  type         String
  data         Json?
  timestamp    DateTime   @default(now())

  @@index([connectionId])
  @@index([timestamp])
  @@map("connection_events")
}

/// A classified, developer-facing error (Phase 9 spec §18-20). `category`
/// is always a Raven concept (never a raw LiveKit/coturn error code) —
/// see `error-classifier.ts` for the mapping and docs/error-codes.md for
/// the full reference.
model ErrorEvent {
  id              String        @id @default(uuid())
  publicId        String        @unique
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment     Environment   @default(DEVELOPMENT)
  connectionId    String?
  connection      Connection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  roomId          String?
  participantId   String?
  category        ErrorCategory
  message         String
  likelyCause     String?
  suggestedAction String?
  sdkVersion      String?
  platform        String?
  timestamp       DateTime      @default(now())

  @@index([projectId])
  @@index([connectionId])
  @@index([category])
  @@index([timestamp])
  @@map("error_events")
}

// ---------------------------------------------------------------------------
// Chat (Phase 12)
//
// Postgres is the source of truth for everything durable below. Presence,
// typing, and WebSocket connection routing are deliberately absent here —
// they live in Redis with TTLs (see docs/chat/architecture.md#redis), because
// writing an `online`/`offline` transition to Postgres on every tab focus is
// exactly the kind of cost this design is trying to avoid.
// ---------------------------------------------------------------------------

enum ConversationType {
  /// Backed by an RTC `Room` — the chat side of a video call.
  ROOM
  /// Standalone, long-lived channel with no RTC room attached.
  CHANNEL
  /// Two-party conversation. Same model, just a different membership shape.
  DIRECT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

/// Coarse roles that expand into the `chat:*` scopes in
/// chat-permissions.ts. Deliberately not a general RBAC system (Phase 12
/// spec §28) — but roles are stored, not scopes, so the mapping can grow
/// without a migration.
enum ChatMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum ChatMemberStatus {
  ACTIVE
  LEFT
}

enum MessageType {
  TEXT
  SYSTEM
  EVENT
  ATTACHMENT
}

enum AttachmentStatus {
  /// Upload URL handed out, bytes not confirmed in object storage yet.
  PENDING
  UPLOADED
  EXPIRED
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// A chat channel. `publicId` (`conv_...`) is what the SDK and dashboard
/// show; the uuid `id` never leaves the API. A conversation may be pinned
/// to an RTC `Room` (type ROOM), which is how a video call gets a chat
/// panel without the developer wiring two identities together.
model Conversation {
  id            String             @id @default(uuid())
  publicId      String             @unique
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment   Environment        @default(DEVELOPMENT)
  /// Set only for type ROOM. One conversation per room, enforced below.
  roomId        String?            @unique
  room          Room?              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name          String
  type          ConversationType   @default(CHANNEL)
  status        ConversationStatus @default(ACTIVE)
  /// Overrides the project/plan default. Null = keep messages indefinitely.
  retentionDays Int?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  members     ChatMember[]
  messages    Message[]
  reactions   Reaction[]
  readStates  ReadState[]
  attachments Attachment[]
  connections ChatConnection[]

  // Names are unique per project so `chat.connect({ room: "support" })`
  // can resolve without the developer having to carry a conv_ id around.
  @@unique([projectId, environment, name])
  @@index([projectId, createdAt])
  @@map("chat_conversations")
}

/// Membership + role for one identity in one conversation. `userId` is the
/// developer's own user identity string (same concept as an RTC
/// participant identity) — Raven never owns end-user accounts.
model ChatMember {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String
  userId         String
  role           ChatMemberRole   @default(MEMBER)
  status         ChatMemberStatus @default(ACTIVE)
  metadata       Json?
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?

  @@unique([conversationId, userId])
  @@index([projectId, userId])
  @@map("chat_members")
}

/// The durable message record. Soft-deleted only (`deletedAt`) so a
/// `message.deleted` event can still name the row and moderation keeps an
/// audit trail — see docs/chat/messages.md#deletion.
model Message {
  id               String       @id @default(uuid())
  publicId         String       @unique
  projectId        String
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Denormalized from the conversation so RTC-room-scoped queries and
  /// webhook payloads don't need a join. Null for CHANNEL/DIRECT.
  roomId           String?
  senderId         String
  type             MessageType  @default(TEXT)
  /// Null for messages that carry no text (a bare attachment, say).
  content          String?
  /// Direct parent. Threads are this same table, not a second store
  /// (spec §26) — `threadRootId` just makes "give me the thread" one
  /// indexed range scan instead of a recursive walk.
  replyToMessageId String?
  replyToMessage   Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]    @relation("MessageReplies")
  threadRootId     String?
  /// Caller-supplied idempotency key. A retry after a reconnect reuses it
  /// and gets the original message back instead of a duplicate (spec §16).
  clientMessageId  String?
  metadata         Json?
  editedAt         DateTime?
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  reactions   Reaction[]
  readStates  ReadState[]
  attachments Attachment[]

  // The idempotency guarantee itself. Scoped to sender as well as
  // conversation so two clients can't collide on a generic key like "1".
  @@unique([conversationId, senderId, clientMessageId], map: "chat_messages_idempotency_key")
  // Covers the only hot read path: newest-first history for one
  // conversation, keyset-paginated on (createdAt, id).
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@index([threadRootId, createdAt])
  @@map("chat_messages")
}

model Reaction {
  id             String       @id @default(uuid())
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())

  // One user, one emoji, one message — a double-tap is a no-op, not a
  // second row (spec §23).
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

/// One row per (conversation, user) holding the *latest* read position,
/// not one row per read event (spec §22). Marking 500 messages read
/// updates a single row.
model ReadState {
  id                String       @id @default(uuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId         String
  userId            String
  lastReadMessageId String?
  lastReadMessage   Message?     @relation(fields: [lastReadMessageId], references: [id], onDelete: SetNull)
  /// createdAt of the last-read message, copied here so "unread count"
  /// is a single range count with no join back to messages.
  lastReadAt        DateTime
  updatedAt         DateTime     @updatedAt

  @@unique([conversationId, userId])
  @@index([lastReadMessageId])
  @@map("chat_read_states")
}

/// Metadata only. The bytes live in S3-compatible object storage and are
/// only ever reached through short-lived signed URLs (spec §30) — no blob
/// ever passes through Postgres or the WebSocket.
model Attachment {
  id             String           @id @default(uuid())
  publicId       String           @unique
  projectId      String
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId     String
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String           @unique
  status         AttachmentStatus @default(PENDING)
  metadata       Json?
  createdAt      DateTime         @default(now())
  uploadedAt     DateTime?

  @@index([conversationId])
  @@index([messageId])
  @@map("chat_attachments")
}

/// One WebSocket session against the chat gateway. Deliberately not one
/// row per presence transition — this is the session, and presence
/// itself is Redis-only. Mirrors the RTC `Connection` model so the
/// dashboard's connection views work the same way for both planes.
model ChatConnection {
  id               String          @id @default(uuid())
  publicId         String          @unique
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment      Environment     @default(DEVELOPMENT)
  conversationId   String?
  conversation     Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  userId           String
  /// Which gateway instance owns the socket — the thing you need when a
  /// single instance in a fleet starts misbehaving.
  gatewayId        String
  state            ConnectionState @default(CONNECTING)
  disconnectReason String?
  sdkVersion       String?
  platform         String?
  messagesSent     Int             @default(0)
  connectedAt      DateTime?
  disconnectedAt   DateTime?
  durationMs       Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([projectId, createdAt])
  @@index([userId])
  @@map("chat_connections")
}

/// A developer-registered webhook target. Project-scoped rather than
/// chat-scoped on purpose: RTC/recording/streaming events in later phases
/// deliver through this same pipeline (spec §31 — no second webhook
/// architecture).
model WebhookEndpoint {
  id                  String                @id @default(uuid())
  publicId            String                @unique
  projectId           String
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment         Environment           @default(DEVELOPMENT)
  url                 String
  description         String?
  /// Empty = every event type. Otherwise an allow-list of `message.created`
  /// style names.
  enabledEvents       String[]              @default([])
  /// HMAC-SHA256 signing key. Has to be recoverable to sign each delivery,
  /// so unlike an API key this is stored as-is and shown once at creation;
  /// it is never returned again. See docs/chat/webhooks.md#signatures.
  signingSecret       String
  status              WebhookEndpointStatus @default(ACTIVE)
  consecutiveFailures Int                   @default(0)
  lastDeliveryAt      DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  deliveries WebhookDelivery[]

  @@index([projectId])
  @@map("webhook_endpoints")
}

/// The event itself, recorded once regardless of how many endpoints it
/// fans out to. `publicId` (`evt_...`) is the idempotency key a receiver
/// should dedupe on (spec §32).
model WebhookEvent {
  id          String      @id @default(uuid())
  publicId    String      @unique
  projectId   String
  /// Part of the delivered envelope, and what stops a staging event from
  /// reaching a production endpoint.
  environment Environment @default(DEVELOPMENT)
  type        String
  payload     Json
  createdAt   DateTime    @default(now())

  deliveries WebhookDelivery[]

  @@index([projectId, createdAt])
  @@map("webhook_events")
}

/// One (event, endpoint) attempt chain. The worker claims rows by
/// `status = PENDING AND nextAttemptAt <= now()`, which is what the
/// composite index below serves.
model WebhookDelivery {
  id             String                @id @default(uuid())
  eventId        String
  event          WebhookEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  responseStatus Int?
  /// Truncated, and never the response body — a failing endpoint can
  /// echo back anything, including things we shouldn't store.
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}
