{
  "name": "@corvidhq/react",
  "version": "0.1.0",
  "description": "React hooks and optional UI primitives for @corvidhq/rtc — headless by default, no UI lock-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulsinghhhh/Raven.git",
    "directory": "packages/react-sdk"
  },
  "homepage": "https://github.com/atulsinghhhh/Raven/tree/main/packages/react-sdk#readme",
  "bugs": {
    "url": "https://github.com/atulsinghhhh/Raven/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@corvidhq/chat": "*",
    "@corvidhq/client": "*",
    "@corvidhq/effects": "*",
    "@corvidhq/rtc": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@corvidhq/chat": {
      "optional": true
    },
    "@corvidhq/client": {
      "optional": true
    },
    "@corvidhq/effects": {
      "optional": true
    },
    "@corvidhq/rtc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@corvidhq/chat": "file:../chat-sdk",
    "@corvidhq/client": "file:../client",
    "@corvidhq/effects": "file:../effects",
    "@corvidhq/rtc": "file:../sdk",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.2.5",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.tsx?$",
    "setupFiles": [
      "<rootDir>/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-after-env.ts"
    ]
  }
}
