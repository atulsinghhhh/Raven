{
  "name": "@corvidhq/effects",
  "version": "0.1.0",
  "description": "Raven Effects — a reusable real-time video effects pipeline (filters, presets) shared by Raven RTC and Raven Live Streaming. Provider-agnostic: takes a MediaStreamTrack, returns a processed MediaStreamTrack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulsinghhhh/Raven.git",
    "directory": "packages/effects"
  },
  "homepage": "https://github.com/atulsinghhhh/Raven/tree/main/packages/effects#readme",
  "bugs": {
    "url": "https://github.com/atulsinghhhh/Raven/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "<rootDir>/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../src/$1"
    }
  }
}
