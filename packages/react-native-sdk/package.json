{
  "name": "@corvidhq/react-native",
  "version": "0.1.0",
  "description": "Raven SDK for React Native — real-time video, voice, and messaging on iOS and Android with the same API as Raven Web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulsinghhhh/Raven.git",
    "directory": "packages/react-native-sdk"
  },
  "homepage": "https://github.com/atulsinghhhh/Raven/tree/main/packages/react-native-sdk#readme",
  "bugs": {
    "url": "https://github.com/atulsinghhhh/Raven/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "keywords": [
    "raven",
    "webrtc",
    "react-native",
    "video",
    "voice",
    "chat",
    "ios",
    "android"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@livekit/react-native": ">=2.7.0",
    "@livekit/react-native-webrtc": ">=125.0.0",
    "@corvidhq/chat": "*",
    "@corvidhq/rtc": "*",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "peerDependenciesMeta": {
    "@corvidhq/chat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@corvidhq/chat": "file:../chat-sdk",
    "@corvidhq/rtc": "file:../sdk",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "jest": "^29.7.0",
    "react": "^19.2.8",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-webrtc": "^144.1.2",
    "livekit-client": "^2.22.0",
    "react-native": "^0.76.5",
    "@react-native-community/netinfo": "^11.4.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "test",
    "testRegex": ".*\\.spec\\.tsx?$",
    "setupFiles": [
      "<rootDir>/setup.ts"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/mocks/react-native.ts",
      "^@livekit/react-native$": "<rootDir>/mocks/livekit-react-native.ts",
      "^@livekit/react-native-webrtc$": "<rootDir>/mocks/livekit-react-native-webrtc.ts"
    }
  }
}
