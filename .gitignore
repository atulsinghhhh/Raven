# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
# Scratch build output used when verifying a running API against a
# separate process — never source, never shippable.
.verify-dist/
build/
.next/
*.tsbuildinfo

# Prisma client gets generated here on build, don't commit it
apps/api/src/generated/

# Python (sdks/python)
.venv/
__pycache__/
*.pyc
*.egg-info/
.mypy_cache/
.pytest_cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# Docker
infrastructure/docker/**/*.local.*

# Local dev TLS cert (self-signed, generated by scripts/generate-turn-cert.sh —
# never commit certs/keys, even self-signed local-only ones)
infrastructure/docker/coturn/certs/

/.docs

# Dart/Flutter build output. `.dart_tool/` is a package cache full of
# absolute paths, so it is machine-specific and never portable.
# `pubspec.lock` is deliberately ignored too: every Dart package here is a
# *library*, and pub's own guidance is that libraries do not pin — an app
# that depends on raven_rtc resolves its own versions.
.dart_tool/
sdks/flutter/*/pubspec.lock

# Vercel CLI project links (per-project, machine-local)
.vercel

# NOTE: do not add a blanket `.env*` here. gitignore is last-match-wins, so
# a trailing `.env*` overrides the `!.env.example` negation at the top of
# this file and silently un-tracks the 89-variable template every developer
# copies to get started. The `.env` / `.env.*` pair up there already covers
# every real env file.

# Generated by scripts/docs-groundtruth.mjs on every docs build; never hand-edited.
apps/docs/groundtruth.json

/test