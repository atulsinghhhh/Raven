# Live Streaming broadcast redesign (backend core). Shared secret between
# apps/api and services/egress-worker — same value on both sides, never
# handed to a client. EGRESS_WORKER_BASE_URL/API_HEARTBEAT_URL are set
# directly in docker-compose.yml (container-to-container addresses), not
# here.
EGRESS_WORKER_SHARED_SECRET=change-me-local-egress-worker-secret
# Azurite's well-known local emulator connection string — see
# docker-compose.yml's egress-worker service comment. Override both for a
# real Azure Storage account + Front Door/CDN endpoint outside local dev.
EGRESS_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
EGRESS_AZURE_STORAGE_CONTAINER=live-hls
EGRESS_CDN_BASE_URL=http://localhost:10000/devstoreaccount1/live-hls


