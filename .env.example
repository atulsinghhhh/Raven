# Raven — local development environment variables
#
# Copy this file to .env and fill in real local values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# These values are for LOCAL DEVELOPMENT ONLY and must never be reused
# in staging or production.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=raven
POSTGRES_USER=raven
POSTGRES_PASSWORD=change-me-local-postgres-password
# Deliberately not 5432: many developer machines already run a native/
# Homebrew Postgres on 5432, which silently intercepts host connections
# ahead of Docker's proxy (Docker's own health checks still pass because
# they run inside the container). 5433 avoids that collision. See
# docs/local-development.md#troubleshooting.
POSTGRES_PORT=5433

# Convenience connection string assembled from the values above
# (matches POSTGRES_* — keep in sync if you change them).
DATABASE_URL=postgresql://raven:change-me-local-postgres-password@localhost:5433/raven

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me-local-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:change-me-local-redis-password@localhost:6379

# ---------------------------------------------------------------------------
# LiveKit (SFU + signaling — see docs/architecture/sfu-comparison.md)
# ---------------------------------------------------------------------------
# API key/secret pair used to sign LiveKit access tokens.
# Generate real local values with:
#   docker run --rm livekit/livekit-server:v1.13.5 generate-keys
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-local-livekit-secret-min-32-chars

# HTTP/WebSocket signaling port (client SDK connects here).
LIVEKIT_PORT=7880
# TCP fallback port for RTC media when UDP is blocked.
LIVEKIT_RTC_TCP_PORT=7881
# UDP port range used for WebRTC media (ICE/SRTP).
LIVEKIT_RTC_UDP_START=50000
LIVEKIT_RTC_UDP_END=50019
# IP LiveKit advertises to clients in ICE candidates. 127.0.0.1 is correct
# for a browser running on the same machine as Docker. See
# docs/local-development.md#troubleshooting if connecting from another device.
LIVEKIT_NODE_IP=127.0.0.1

# Full local WebSocket URL the SDK will use to connect (Phase 6+).
LIVEKIT_URL=ws://localhost:7880
# Used only by the api process itself (RoomServiceClient for live room
# state, /health) — never returned to a client. Host-reachable here, like
# LIVEKIT_URL, for `pnpm start:dev`/e2e tests run directly on the host;
# docker-compose.yml hardcodes the container-internal value for the
# dockerized api service instead of reading this var (same pattern as
# DATABASE_URL/REDIS_URL). See docs/dashboard.md#health.
LIVEKIT_INTERNAL_URL=http://localhost:7880

# ---------------------------------------------------------------------------
# coturn (TURN/STUN — see docs/architecture/turn.md and docs/sfu.md)
# ---------------------------------------------------------------------------
# Shared secret used for coturn's time-limited REST-API credential scheme.
# The RTC Token endpoint (Phase 4) uses this to mint short-lived TURN
# username/credential pairs per request — never issue this secret to
# clients directly.
TURN_SECRET=change-me-local-turn-shared-secret-min-32-chars
TURN_REALM=raven.local
# Host-facing address returned to clients — deliberately not the internal
# Docker service name "coturn". See docs/sfu.md#turn-integration.
TURN_HOST=localhost
# Used only by the api process's own /health STUN check — never returned
# to a client. Host-reachable here, like TURN_HOST; docker-compose.yml
# hardcodes the container-internal value for the dockerized api service.
TURN_INTERNAL_HOST=localhost
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# TURNS (TLS)/DTLS port — see docs/turn.md#tls. Requires
# infrastructure/docker/coturn/certs/{cert,key}.pem to exist locally
# (run: bash scripts/generate-turn-cert.sh). Self-signed, local dev only.
TURN_TLS_PORT=5349
# Per-user / global concurrent allocation caps and per-session bandwidth
# cap (bytes/sec) — see docs/turn.md#abuse-protection. Local-dev-sized
# defaults; revisit for real production capacity planning.
TURN_USER_QUOTA=10
TURN_TOTAL_QUOTA=400
TURN_MAX_BPS=1000000
# Prometheus metrics endpoint — see docs/turn.md#turn-usage-metrics.
# Local dev convenience only; never expose this publicly in production.
TURN_PROMETHEUS_PORT=9641

# ---------------------------------------------------------------------------
# Control Plane API (apps/api — see docs/control-plane.md)
# ---------------------------------------------------------------------------
# Deliberately not 4000/8080: very commonly occupied by other local dev
# tooling. See docs/local-development.md#troubleshooting.
API_PORT=4100

# Signs developer-session JWTs (dashboard-style auth: register/login).
# Generate a real local value with: openssl rand -hex 32
JWT_SECRET=change-me-local-jwt-secret-min-32-chars
JWT_EXPIRES_IN=12h

# Default lifetime for a minted RTC token when the caller doesn't specify
# ttlSeconds. Short-lived by design — see docs/architecture/webrtc.md.
RTC_TOKEN_DEFAULT_TTL_SECONDS=600

# Pepper mixed into API key secrets before bcrypt hashing (on top of
# bcrypt's own per-key salt). Lives only here, never in the database — a
# database-only leak isn't enough by itself to brute-force key secrets.
# Generate a real local value with: openssl rand -hex 32
API_KEY_HASH_SECRET=change-me-local-api-key-pepper-min-32-chars

# Comma-separated allowed browser origins, or "*" for local dev only.
# Never use "*" in production — see docs/control-plane.md#cors.
CORS_ORIGIN=*

# Fixed-window size for the Redis-based rate limiter (login, register,
# api-key creation, rtc-token creation). See docs/control-plane.md#rate-limiting.
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Signaling (Phase 3 — see docs/signaling.md)
# ---------------------------------------------------------------------------
SIGNALING_MAX_PARTICIPANTS_PER_ROOM=50
SIGNALING_MAX_MESSAGE_BYTES=16384
SIGNALING_MAX_MESSAGES_PER_WINDOW=100
SIGNALING_MESSAGE_WINDOW_SECONDS=10
SIGNALING_MAX_CONNECTIONS_PER_WINDOW=20
