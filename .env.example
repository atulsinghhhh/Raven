# Raven dev env vars.
#
# Copy this to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials. Most values here are
# local-dev-only and must not be reused in staging or production; the
# exception is the Supabase database below, which is a real hosted service
# and the same one every environment uses. Treat its password accordingly.

# ---------------------------------------------------------------------------
# PostgreSQL (Supabase — managed, external)
# ---------------------------------------------------------------------------
# Raven has no local Postgres container. There is one database, hosted on
# Supabase, and every environment (including your laptop) talks to it.
# docker-compose.yml provides Redis/SFU/coturn/MinIO only.
#
# Supabase provides *only* managed Postgres here. Raven speaks to it over
# Prisma 7 + the @prisma/adapter-pg driver adapter, exactly as it did to the
# Docker container — no Supabase SDK, no Supabase Auth, no Supabase REST.
#
# Both strings come from the Supabase dashboard under
# Project Settings -> Database -> Connection string. Prefer the shared
# pooler hostname (aws-0-<region>.pooler.supabase.com) over the direct
# db.<ref>.supabase.co host, which is IPv6-only on the free tier and a
# common source of ENETUNREACH from CI runners and small VMs.
#
# Full walkthrough: docs/deployment/managed-postgres.md

# The running API's connection — transaction-mode pooler, port 6543.
# Transaction pooling is what keeps N instances x DATABASE_POOL_MAX under
# Supabase's connection ceiling.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# The Prisma CLI's connection — session mode, port 5432. Nothing else reads
# it (see apps/api/prisma.config.ts). Migrations need one session they can
# hold an advisory lock on across several statements, which transaction
# pooling will not give them: run `prisma migrate deploy` through :6543 and
# you get a hang or a lock error rather than a clear message.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# pg.Pool sizing for apps/api (prisma.service.ts). N instances x poolMax
# must stay comfortably under the database's own max_connections — see
# docs/production/capacity-report.md for the measured numbers this default
# is based on, and note that a Supabase free-tier project has a much lower
# ceiling than a self-hosted Postgres. The pooler on :6543 is what makes
# this default workable; keep DATABASE_URL pointed at it.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me-local-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:change-me-local-redis-password@localhost:6379
# Upper bound on a single Redis command. Exists so a *hung* Redis (network
# partition, paused container, a server too busy to answer) surfaces as an
# error — which callers like presence, rate limiting and chat fan-out fail
# open on — instead of an unbounded wait. Anything slower than this is a
# fault, not slowness.
REDIS_COMMAND_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# coturn (TURN/STUN — see docs/rtc/networking.md)
# ---------------------------------------------------------------------------
# Shared secret for coturn's time-limited REST-API credential scheme. The
# RTC Token endpoint uses this to mint short-lived TURN username/credential
# pairs per request — never hand this secret to clients directly.
TURN_SECRET=change-me-local-turn-shared-secret-min-32-chars
TURN_REALM=raven.local
# Host-facing address returned to clients, not the internal Docker service
# name "coturn".
TURN_HOST=localhost
# Only for the api process's own /health STUN check — never returned to a
# client. Host-reachable here like TURN_HOST; docker-compose.yml hardcodes
# the container-internal value for the dockerized api service.
TURN_INTERNAL_HOST=localhost
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# TURNS (TLS)/DTLS port. Needs infrastructure/docker/coturn/certs/{cert,key}.pem
# to exist locally — run bash scripts/generate-turn-cert.sh first. Self-signed, local dev only.
TURN_TLS_PORT=5349
# Per-user/global concurrent allocation caps and bandwidth cap (bytes/sec).
# These are local-dev-sized defaults — revisit before real production
# capacity planning.
TURN_USER_QUOTA=10
TURN_TOTAL_QUOTA=400
TURN_MAX_BPS=1000000
# Prometheus metrics endpoint — local dev convenience, don't expose this
# publicly in production.
TURN_PROMETHEUS_PORT=9641

# ---------------------------------------------------------------------------
# Control Plane API (apps/api — see docs/control-plane.md)
# ---------------------------------------------------------------------------
# Not 4000/8080 on purpose — those get grabbed by other local dev tooling
# way too often.
API_PORT=4100

# pino level name: trace/debug/info/warn/error/fatal. Every log line is
# structured JSON regardless of level (NativeLogger in main.ts) — this
# only controls the volume, not the shape.
LOG_LEVEL=info

# Signs developer-session JWTs (dashboard-style auth: register/login).
# Generate a real local value with: openssl rand -hex 32
JWT_SECRET=change-me-local-jwt-secret-min-32-chars
JWT_EXPIRES_IN=12h

# Default lifetime for a minted RTC token when the caller skips ttlSeconds.
# Kept short-lived on purpose.
RTC_TOKEN_DEFAULT_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Native Raven RTC — see docs/rtc/architecture.md
# ---------------------------------------------------------------------------

# Signs Raven's own RTC tokens. MUST be distinct from JWT_SECRET (dashboard
# sessions) and CHAT_TOKEN_SECRET (chat) — a leak of any one of the three
# must not be able to mint the other two. Production boot fails if this is
# unset or shares a value with either.
#   openssl rand -hex 32
RTC_TOKEN_SECRET=change-me-local-rtc-token-secret-min-32-chars

# Where clients connect for signaling — handed back as `endpoint` in the
# token-mint response. Derived from API_PUBLIC_URL when unset, which is
# what you want unless signaling is fronted on its own hostname/ingress.
# Must be wss:// in production; RTC tokens travel on this connection.
# RTC_SIGNALING_URL=wss://api.example.com/v1/rtc

# Shared secret the SFU fleet authenticates to the control plane with when
# registering and heartbeating. Server-to-server only — never handed to a
# client. Must differ from RTC_TOKEN_SECRET: a leaked client-token key must
# not let an attacker register itself as an RTC server and be handed rooms.
SFU_REGISTRATION_SECRET=change-me-local-sfu-registration-secret

# An SFU that has not heartbeated within this window stops receiving new
# room allocations. Must comfortably exceed the SFU's own heartbeat
# interval, or healthy nodes flap in and out of the pool.
SFU_HEARTBEAT_TIMEOUT_SECONDS=30

# Region used for room allocation when the request names none and the
# project has no configured preference.
SFU_DEFAULT_REGION=local

# --- The SFU node itself (services/sfu) -----------------------------------
# Only read by the SFU process, not the API.

SFU_NODE_ID=sfu-local-01
SFU_REGION=local
# What clients are told to reach for media.
SFU_PUBLIC_HOST=localhost
# What the SFU advertises in ICE candidates. MUST be a routable address in
# production — without it every candidate carries a private container IP
# no client can reach, and only TURN relays work.
SFU_PUBLIC_IP=127.0.0.1
SFU_HTTP_PORT=7000
SFU_ROOM_CAPACITY=100
# Media. Must be published one-to-one — ICE advertises the exact port it
# bound, so a remapped range hands clients addresses that do not exist.
# See docs/rtc/networking.md.
SFU_UDP_PORT_MIN=51000
SFU_UDP_PORT_MAX=51200
SFU_LOG_LEVEL=info


# Pepper mixed into API key secrets before bcrypt hashing, on top of
# bcrypt's own per-key salt. Only lives here, never in the database — so a
# database-only leak alone isn't enough to brute-force key secrets.
# Generate a real local value with: openssl rand -hex 32
API_KEY_HASH_SECRET=change-me-local-api-key-pepper-min-32-chars

# Comma-separated allowed browser origins, or "*" for local dev. Don't use
# "*" in production — see docs/control-plane.md#cors.
CORS_ORIGIN=*

# Fixed-window size for the Redis-based rate limiter (login, register,
# api-key creation, rtc-token creation).
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Signaling (Phase 3 — see docs/signaling.md)
# ---------------------------------------------------------------------------
SIGNALING_MAX_PARTICIPANTS_PER_ROOM=50
SIGNALING_MAX_MESSAGE_BYTES=16384
SIGNALING_MAX_MESSAGES_PER_WINDOW=100
SIGNALING_MESSAGE_WINDOW_SECONDS=10
SIGNALING_MAX_CONNECTIONS_PER_WINDOW=20

# ---------------------------------------------------------------------------
# Raven Chat (Phase 12 — see docs/chat/overview.md)
# ---------------------------------------------------------------------------
# Signing key for short-lived chat tokens. MUST differ from JWT_SECRET —
# a leaked dashboard-session key must not be able to mint chat credentials.
# Generate with: openssl rand -hex 32
CHAT_TOKEN_SECRET=change-me-local-chat-token-secret-min-32-chars
# Chat tokens are always short-lived; there is no non-expiring chat token.
CHAT_TOKEN_DEFAULT_TTL_SECONDS=3600
CHAT_TOKEN_MAX_TTL_SECONDS=21600

# Payload ceilings, enforced identically on the WebSocket and HTTP paths.
CHAT_MAX_TEXT_LENGTH=4000
CHAT_MAX_METADATA_BYTES=4096
CHAT_MAX_FRAME_BYTES=65536
CHAT_MAX_REACTIONS_PER_MESSAGE=200
CHAT_MAX_ROOM_SUBSCRIPTIONS=20
CHAT_MAX_HISTORY_PAGE_SIZE=100

# Per-user rate limits, Redis-backed so they hold across gateway instances.
CHAT_SEND_RATE_LIMIT=30
CHAT_SEND_RATE_WINDOW_SECONDS=10
CHAT_REACTION_RATE_LIMIT=60
CHAT_TYPING_RATE_LIMIT=20
CHAT_SUBSCRIBE_RATE_LIMIT=60
CHAT_CONNECTION_RATE_LIMIT=30

# Ephemeral-state TTLs. presence must outlive a heartbeat cycle (25s) or a
# healthy connection would flap offline between pings.
CHAT_PRESENCE_TTL_SECONDS=45
CHAT_TYPING_TTL_SECONDS=7

# Message retention. 0 = keep forever (the default). A per-conversation
# retentionDays overrides this. See docs/chat/overview.md#retention.
CHAT_RETENTION_DAYS=0
CHAT_RETENTION_SWEEP_INTERVAL_MS=21600000

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_BASE_MS=10000
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_POLL_INTERVAL_MS=2000
WEBHOOK_BATCH_SIZE=20
WEBHOOK_DISABLE_AFTER_FAILURES=50

# ---------------------------------------------------------------------------
# Object storage (chat attachments — S3-compatible: MinIO, S3, R2, Spaces)
# ---------------------------------------------------------------------------
# Leave STORAGE_BUCKET unset to disable attachments entirely; the API then
# returns ATTACHMENTS_NOT_CONFIGURED rather than half-working.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=raven-attachments
STORAGE_ACCESS_KEY_ID=raven-minio-access-key
STORAGE_SECRET_ACCESS_KEY=change-me-local-minio-secret-key
# MinIO needs path-style URLs; real S3 prefers virtual-host style.
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=900
STORAGE_MAX_ATTACHMENT_BYTES=26214400

# ---------------------------------------------------------------------------
# Raven Community (apps/community-api + apps/community)
#
# A separate application that CONSUMES Raven as an external customer would —
# see apps/community-api/README.md. It owns its own tables and never touches
# Raven's.
# ---------------------------------------------------------------------------
# Its own Postgres *schema* on the same Supabase database — not its own
# database, which the free tier's pooler will not route to, and not Raven's
# `public` schema, which it must never touch. Prisma creates the schema on
# first `migrate deploy`. Use the :5432 session-mode string here, same as
# DIRECT_URL: apps/community-api/prisma.config.ts is CLI-only.
COMMUNITY_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=raven_community
COMMUNITY_API_PORT=4200
COMMUNITY_JWT_SECRET=change-me-local-community-jwt-secret-min-32-chars
COMMUNITY_JWT_EXPIRES_IN=12h
COMMUNITY_CORS_ORIGIN=http://localhost:3300

# The frontend's own base URL for calling community-api (mirrors
# apps/dashboard's RAVEN_API_URL convention — see apps/community/src/lib/api-client.ts).
COMMUNITY_API_URL=http://localhost:4200

# This app's OWN Raven credential — a project API key minted from apps/api's
# dashboard (http://localhost:3000 once apps/api + apps/dashboard are
# running), exactly as any Raven customer would get one. Chat/RTC/Live
# features stay disabled (logged, not crashed) until this is set — see
# apps/community-api/src/raven/raven-client.provider.ts.
RAVEN_API_URL=http://localhost:4100
RAVEN_API_KEY=
